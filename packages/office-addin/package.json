{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@swarm/office-addin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Swarm Office Add-in: task pane (Solid + Vite), shared constants and manifest source.",
  "type": "module",
  "exports": {
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "dev": "vite",
    "build": "vite build",
    "test": "bun test --conditions=solid --only-failures --preload ./happydom.ts ./src"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.12.0",
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/office-js": "1.0.617",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "dependencies": {
    "@opencode-ai/sdk": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "2.2.1",
    "solid-js": "catalog:"
  }
}
