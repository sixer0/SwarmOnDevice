#!/bin/sh
# rsvg-convert: DATUM shim (datum-render-shim 1.2.0), not librsvg. Installed at
# Resources/datum-runtime/bin/rsvg-convert beside bin/datum-python; forwards to Swarm's render
# bridge (Electron's Chromium). Runtime spec 3.2 (b). -I -B: no env, no cwd on sys.path, no .pyc.
self=$(/usr/bin/readlink -f "$0") || exit 1
dir=$(/usr/bin/dirname "$self")
exec "$dir/../python/bin/python3" -I -B -m datum_render_shim.rsvg_convert "$@"
