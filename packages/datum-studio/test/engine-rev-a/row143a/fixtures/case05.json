                    {
                      "label": {
                        "text": "                           ─────────────────"
                      }
                    },
                    {
                      "label": {
                        "text": "Panjang total      48 × 38,5  = 1.848,0  m"
                      }
                    },
                    {
                      "label": {
                        "text": "Bus A R1 sampai R2 25 × 38,5  =   962,5  m"
                      }
                    },
                    {
                      "label": {
                        "text": "Bus B R3 sampai R4 23 × 38,5  =   885,5  m"
                      }
                    },
                    {
                      "label": {
                        "text": "Batas panjang bus RS-485        1.200,0  m"
                      }
                    }
                  ],
                  "closing": {
                    "text": "Bila ruang R1 atau R2 ditambah 7 titik, bus A menjadi 1.232,0 m dan melewati batas; titik tambahan harus masuk gerbang ketiga. Panjang total tidak bergantung pada pembagian bus."
                  },
                  "result": {
                    "label": {
                      "text": "Pemakaian bus A  962,5 ÷ 1.200,0 ="
                    },
                    "expr": "bus_a / batas_bus * 100",
                    "registerKey": "pemakaian_bus_a"
                  }
