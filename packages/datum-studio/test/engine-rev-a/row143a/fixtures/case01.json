                    {
                      "kind": "mark",
                      "mark": "PEMASOK"
                    },
                    {
                      "kind": "source",
                      "text": "LBR DATA PEMASOK"
                    },
                    {
                      "kind": "source",
                      "text": "KEANDALAN [B2]"
                    },
                    {
                      "kind": "note",
                      "text": "Daya perangkat diambil dari lembar data pemasok."
