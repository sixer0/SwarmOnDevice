#!/usr/bin/env bash
set -euo pipefail
APP=swarm

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
Swarm Installer (local-only)

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -b, --binary <path>     Install the Swarm binary from this local path
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

The binary is taken from --binary or, by default, from a file named "swarm"
sitting next to install.sh. This script never contacts a network host.

Examples:
    ./install.sh
    ./install.sh --binary /path/to/swarm
EOF
}

no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

# R2: macOS Apple Silicon only. A Rosetta shell reports x86_64 from uname -m,
# so also accept hw.optional.arm64 to recognise Apple Silicon behind translation.
if [ "$(uname -s)" != "Darwin" ]; then
    echo -e "${RED}Error: Swarm installs on macOS (darwin-arm64) only.${NC}" >&2
    exit 1
fi
if [ "$(uname -m)" != "arm64" ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" != "1" ]; then
    echo -e "${RED}Error: Swarm installs on Apple Silicon (darwin-arm64) only.${NC}" >&2
    exit 1
fi

# R3: the binary comes from --binary or, by default, the file named swarm next to
# this script. There is no download path; this installer never contacts a network host.
source_path="$binary_path"
if [ -z "$source_path" ]; then
    source_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$APP"
fi
if [ ! -f "$source_path" ]; then
    echo -e "${RED}Error: No Swarm binary found at ${source_path}.${NC}" >&2
    echo -e "${MUTED}Pass --binary <path>, or place the 'swarm' file next to install.sh.${NC}" >&2
    exit 1
fi

# R8: report a quarantine attribute but never remove it. Clearing it is a deliberate,
# documented user action (see README); stripping it silently would defeat Gatekeeper.
if [ -n "$(xattr -p com.apple.quarantine "$source_path" 2>/dev/null || true)" ]; then
    echo -e "${ORANGE}Note:${NC} the source file carries a com.apple.quarantine attribute."
    echo -e "${MUTED}Verify the archive's SHA-256 first; the README documents how to clear the attribute if macOS blocks the binary. Continuing.${NC}"
fi

# R4: smoke-test the source before installing anything.
if ! version_output=$("$source_path" --version 2>/dev/null) || [ -z "$version_output" ]; then
    echo -e "${RED}Error: Smoke test failed ('$APP --version' printed no version). Nothing was installed.${NC}" >&2
    exit 1
fi

INSTALL_DIR="$HOME/.swarm/bin"
print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

# R5: fixed destination, mode 755; never replace a directory.
mkdir -p "$INSTALL_DIR"
DEST="$INSTALL_DIR/$APP"
if [ -d "$DEST" ]; then
    echo -e "${RED}Error: Refusing to replace directory ${DEST}.${NC}" >&2
    exit 1
fi

if [ -f "$DEST" ] && cmp -s "$source_path" "$DEST"; then
    # R11: identical bytes already installed; report and change nothing.
    print_message info "${MUTED}Version ${NC}${version_output}${MUTED} already installed at ${NC}${DEST}"
else
    print_message info "\n${MUTED}Installing ${NC}${APP} ${MUTED}version: ${NC}${version_output} ${MUTED}from: ${NC}${source_path}"
    # R10: temp name swarm_install_$$, same filesystem as DEST so the move is atomic.
    tmp="${INSTALL_DIR}/swarm_install_$$"
    trap 'rm -f "${tmp:-}"' EXIT
    cp "$source_path" "$tmp"
    chmod 755 "$tmp"
    mv -f "$tmp" "$DEST"
    trap - EXIT
fi

# R5a (AD-15): when an rg binary ships beside the source, copy it into the same bin dir so the
# resolver's first candidate (dirname(execPath)/rg) finds it with no runtime download. Copy only
# when present; a plain install without a bundled rg stays clean and falls back to PATH or fail-closed.
rg_source="$(dirname "$source_path")/rg"
if [ -f "$rg_source" ]; then
    rg_dest="$INSTALL_DIR/rg"
    if [ ! -f "$rg_dest" ] || ! cmp -s "$rg_source" "$rg_dest"; then
        rg_tmp="${INSTALL_DIR}/rg_install_$$"
        cp "$rg_source" "$rg_tmp"
        chmod 755 "$rg_tmp"
        mv -f "$rg_tmp" "$rg_dest"
    fi
fi

add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        # R6/I07: marker block pairs with swarm uninstall (register U02/U03).
        echo -e "\n# swarm" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}${APP} ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=\$HOME/.swarm/bin:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        # R6: register literals, written unexpanded so each shell resolves \$HOME itself.
        case $current_shell in
            fish)
                add_to_path "$config_file" 'fish_add_path $HOME/.swarm/bin'
            ;;
            zsh|bash|ash|sh)
                add_to_path "$config_file" 'export PATH=$HOME/.swarm/bin:$PATH'
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=\$HOME/.swarm/bin:\$PATH"
            ;;
        esac
    fi
fi

echo -e ""
echo -e "${MUTED}#### #  #  ##  #### #  #${NC}"
echo -e "${MUTED}#    #  # #  # #  # ## #${NC}"
echo -e "${MUTED}#### # ## #### ###  # ##${NC}"
echo -e "${MUTED}   # #### #  # # ## #  #${NC}"
echo -e "${MUTED}####  ##  #  # #  # #  #${NC}"
echo -e ""
echo -e "${MUTED}Swarm ${version_output} installed. To start:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "swarm         ${MUTED}# Run command${NC}"
echo -e ""
